# Supabase: Project Settings -> Database -> Connect.
# Vercel/serverless: Supavisor Transaction pooler (port 6543) + pgbouncer=true.
DATABASE_URL="postgresql://postgres.your-project:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# db:push/seed: Direct connection (port 5432), hoặc Supavisor Session pooler (port 5432) nếu mạng không có IPv6.
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"
ADMIN_EMAIL="owner@909lumina.vn"
ADMIN_PASSWORD="change-this-before-running-the-seed"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare R2: ảnh upload từ Admin được lưu tại prefix R2_UPLOAD_PREFIX.
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_API_TOKEN="your_cloudflare_api_token"
R2_BUCKET_NAME="cho-acc-lienquan"
R2_PUBLIC_URL="https://pub-331231a8c21d4e6db2f224146773362c.r2.dev"
R2_UPLOAD_PREFIX="909-lumina"
